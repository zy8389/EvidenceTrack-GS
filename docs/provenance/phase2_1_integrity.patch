+            raise ValueError(
+                f"Paired identity {prefix} Difix protocol is stale or fabricated"
+            )
+    if metadata["a1_difix_protocol"] != metadata["b_difix_protocol"]:
+        raise ValueError("Paired identity arms use different Difix scientific configuration")
+    for prefix in ("a1", "b"):
