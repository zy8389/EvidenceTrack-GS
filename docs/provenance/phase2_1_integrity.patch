+    binding = {
+        "manifest_schema": HELDOUT_DIAGNOSTIC_MANIFEST_SCHEMA,
+        "supervision_target_kind": "difix",
+        "dataset": str(args.dataset),
+        "scene": scene_name,
+        "seed": int(args.seed),
+        "experiment_role": experiment_role,
+        "scene_source_path": str(scene_source_path),
+        "paired_identity_arm": arm,
