+)
+
+
+VARIANTS = {
+    "GS Render + feature matching": "gs_render",
+    "Difix Output + feature matching": "difix_output",
+    "Real Target + feature matching [reference diagnostic]": "real_target",
+}
+PAIRED_MANIFEST_SCHEMA = "paired_identity_manifest_v4"
