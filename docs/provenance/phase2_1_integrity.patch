+        root,
+        1.0,
+        4.0,
+        scale,
+    )
+    changed = [dict(item) for item in observations]
+    changed[2]["xy"] = changed[2]["xy"] + np.asarray([900.0, -700.0])
+    second = build_record(
+        point_track,
+        changed,
+        {"image_1", "image_2"},
+        {"image_3"},
