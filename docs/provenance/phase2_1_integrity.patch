+        controlled_metadata_path.read_text(encoding="utf-8")
+    )
+    if not isinstance(controlled_metadata, dict):
+        raise ValueError("Controlled run metadata must be a JSON object")
+    arm = str(controlled_metadata.get("role", "")).upper()
